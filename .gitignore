.env
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vscode/
.claude/
.kilo
.cursor
web/var/

# служебная обвязка opencode: кастомные tools коммитятся
.opencode/*
!.opencode/tools/

# папки с локальным содержимым - коммитить только .gitkeep
data/*
!data/.gitkeep
!data/skills/
log/*
!log/.gitkeep
debug/*
!debug/.gitkeep
input/*
!input/.gitkeep
output/*
!output/.gitkeep

# Артефакты сессий коммитятся полностью: скриншоты, input/, output/, data/.
# Проектовый оверрайд к разделу 06.01 - doc/specs/overrides.md.
# Служебные каталоги (.venv/, __pycache__/, кэши) исключены правилами выше.

# разовые артефакты - целиком, без .gitkeep
tmp/

# карантин удаляемого - целиком, без .gitkeep
.trash/

# архивы .arch - на любой глубине, без .gitkeep
.arch/

# транзитная папка doc/
doc/agent_questions/*
!doc/agent_questions/.gitkeep
